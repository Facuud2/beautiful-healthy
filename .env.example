# ==================================================
# 🏥 Beautiful Health - Variables de Entorno
# ==================================================

# --------------------------------------------------
# 🐘 PostgreSQL Database Configuration
# --------------------------------------------------
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/beautiful_health_db?sslmode=disable
# --------------------------------------------------
# 🔐 Application Configuration
# --------------------------------------------------
APP_ENV=development
APP_PORT=6060
APP_DEBUG=true

# --------------------------------------------------
# 🔑 JWT Configuration (si usas autenticación)
# --------------------------------------------------
JWT_SECRET_KEY=K7m#9P2vR8nX4bZ6cD9fG1hJ3kL7qW5eR8tY2uI4oA6sD9fG1hJ3kL7mN9p

# --------------------------------------------------
# 📧 Email Configuration (si envías emails)
# --------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@beautifulhealth.com

# --------------------------------------------------
# 🚨 Logging Configuration
# --------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json

# --------------------------------------------------
# 🌐 API Configuration
# --------------------------------------------------
API_VERSION=v1
API_BASE_PATH=/api/v1

# --------------------------------------------------
# 📦 Private / Public Key Authentication
# --------------------------------------------------

RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----"

# RSA_PUBLIC_KEY="------BEGIN PUBLIC KEY------"

# Estas variables serán usadas por tu aplicación Go para conectarse a Vault (solo local)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-token

# --------------------------------------------------
# 🔑 Database Password
# --------------------------------------------------
DB_PASSWORD=L5x6%2FrhVGe%23Au-%24

